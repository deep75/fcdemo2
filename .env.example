# -----------------------------------------------------------------------
# FranceConnect Service Provider - Environment Variables
# -----------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Express session secret — use a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# FranceConnect OIDC client credentials
# (overrides values in config/config.json)
FC_CLIENT_ID=your-franceconnect-client-id
FC_CLIENT_SECRET=your-franceconnect-client-secret

# Optional: Node environment (development | production)
NODE_ENV=development
